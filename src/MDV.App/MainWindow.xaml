<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MDV_App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MDV_App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MDV"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="MDV">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- メニューバー + テーマ切替アイコン(文字列は x:Uid で Strings/<言語>/Resources.resw から読み込む) -->
        <Grid Grid.Row="1">
            <MenuBar>
                <MenuBarItem x:Uid="MenuFile">
                    <MenuFlyoutItem x:Uid="MenuOpen" Click="OnOpenClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="O" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuPrint" Click="OnPrint">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="P" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="MenuExit" Click="OnExitClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F4" Modifiers="Menu"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuView">
                    <MenuFlyoutSubItem x:Uid="MenuTheme">
                        <MenuFlyoutItem x:Uid="MenuThemeLight" Click="OnThemeLight"/>
                        <MenuFlyoutItem x:Uid="MenuThemeDark" Click="OnThemeDark"/>
                        <MenuFlyoutItem x:Uid="MenuThemeSystem" Click="OnThemeSystem"/>
                    </MenuFlyoutSubItem>
                    <!-- 項目は翻訳のある言語から実行時に生成する(MainWindow.BuildLanguageMenu) -->
                    <MenuFlyoutSubItem x:Name="LanguageMenu" x:Uid="MenuLanguage"/>
                    <MenuFlyoutItem x:Uid="MenuZoomIn" Click="OnZoomIn" KeyboardAcceleratorTextOverride="Ctrl +"/>
                    <MenuFlyoutItem x:Uid="MenuZoomOut" Click="OnZoomOut" KeyboardAcceleratorTextOverride="Ctrl -"/>
                    <MenuFlyoutItem x:Uid="MenuZoomReset" Click="OnZoomReset">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="Number0" Modifiers="Control"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem x:Uid="MenuReload" Click="OnReload">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F5"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem x:Uid="MenuToggleStatusBar" Click="OnToggleStatusBar"/>
                </MenuBarItem>
                <MenuBarItem x:Uid="MenuHelp">
                    <MenuFlyoutItem x:Uid="MenuAbout" Click="OnAboutClick">
                        <MenuFlyoutItem.KeyboardAccelerators>
                            <KeyboardAccelerator Key="F1"/>
                        </MenuFlyoutItem.KeyboardAccelerators>
                    </MenuFlyoutItem>
                </MenuBarItem>
            </MenuBar>
            <Button x:Name="ThemeToggle" Click="OnThemeToggle"
                    HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                    Content="🌙" FontSize="16" Margin="0,0,8,0"/>
        </Grid>

        <!-- 本文 -->
        <WebView2 x:Name="ContentView" Grid.Row="2"/>

        <!-- ステータスバー -->
        <Grid x:Name="StatusBar" Grid.Row="3" Padding="8,2" Background="{ThemeResource SystemControlBackgroundChromeMediumLowBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="EncodingText" Grid.Column="0" Text=""/>
            <TextBlock x:Name="LineEndingText" Grid.Column="1" Text=""/>
        </Grid>
    </Grid>
</Window>
